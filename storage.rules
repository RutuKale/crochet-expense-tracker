rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Match files scoped to business
    match /businesses/{businessId}/{allPaths=**} {
      // Must be authenticated to read or write business assets
      allow read: if isAuthenticated();
      // Allow image and pdf uploads up to 5MB
      allow write: if isAuthenticated()
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
