rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    // Check if user is a member of the given business
    function isBusinessMember(businessId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
      );
    }
    
    // Check if user is the business owner
    function isBusinessOwner(businessId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
      );
    }

    // User profile collection
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Business documents and subcollections
    match /businesses/{businessId} {
      // Owner can read and write business record; members can read
      allow read: if isBusinessMember(businessId);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isBusinessOwner(businessId);

      // Members subcollection
      match /members/{memberId} {
        allow read: if isBusinessMember(businessId);
        allow write: if isBusinessOwner(businessId);
      }

      // Settings subcollection (general, invoice, pricing defaults)
      match /settings/{settingId} {
        allow read: if isBusinessMember(businessId);
        allow write: if isBusinessOwner(businessId);
      }

      // Raw Materials & Purchases
      match /rawMaterials/{materialId} {
        allow read, write: if isBusinessMember(businessId);
      }
      match /materialPurchases/{purchaseId} {
        allow read, write: if isBusinessMember(businessId);
      }
      match /materialMovements/{movementId} {
        allow read: if isBusinessMember(businessId);
        // Immutable ledger: creations only, no edits or deletes
        allow create: if isBusinessMember(businessId);
        allow update, delete: if false;
      }

      // Products, Recipes, Production
      match /products/{productId} {
        allow read, write: if isBusinessMember(businessId);
      }
      match /recipes/{recipeId} {
        allow read, write: if isBusinessMember(businessId);
      }
      match /productionBatches/{batchId} {
        allow read: if isBusinessMember(businessId);
        allow create: if isBusinessMember(businessId);
        allow update, delete: if false; // Batches are immutable once committed
      }
      match /finishedStockMovements/{movementId} {
        allow read: if isBusinessMember(businessId);
        allow create: if isBusinessMember(businessId);
        allow update, delete: if false; // Immutable finished stock ledger
      }

      // Customers & Orders
      match /customers/{customerId} {
        allow read, write: if isBusinessMember(businessId);
      }
      match /orders/{orderId} {
        allow read, write: if isBusinessMember(businessId);
      }

      // Sales, Payments & Receivables
      match /sales/{saleId} {
        allow read: if isBusinessMember(businessId);
        allow create: if isBusinessMember(businessId);
        allow update: if isBusinessMember(businessId) && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAmount', 'balanceAmount', 'updatedAt', 'notes']);
        allow delete: if false; // Invoices cannot be deleted, only voided/refunded
      }
      match /payments/{paymentId} {
        allow read, create: if isBusinessMember(businessId);
        allow update, delete: if false; // Payment records are immutable ledger entries
      }

      // Operating Expenses
      match /expenses/{expenseId} {
        allow read, write: if isBusinessMember(businessId);
      }

      // Price Calculations
      match /priceCalculations/{calculationId} {
        allow read, write: if isBusinessMember(businessId);
      }

      // Audit Logs
      match /auditLogs/{logId} {
        allow read: if isBusinessOwner(businessId);
        allow create: if isBusinessMember(businessId);
        allow update, delete: if false; // Audit logs are strictly append-only
      }
    }

    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
